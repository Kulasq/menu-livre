# =============================================================================
# .env.example — Template de configuração do Menu Livre
# Copie para .env e preencha com os valores reais do seu ambiente
# NUNCA commitar o .env real — ele está no .gitignore
# =============================================================================

# Segurança — gere chaves únicas com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
REFRESH_SECRET_KEY=

# Banco de dados (caminho relativo ao diretório backend/)
DATABASE_URL=sqlite:///./data/cardapio.db

# WhatsApp — número com DDI, sem espaços ou símbolos (ex: 5581999999999)
WHATSAPP_NUMBER=

# CORS — domínio(s) do frontend em produção (lista JSON)
# Em desenvolvimento não é necessário (DEBUG=true libera tudo)
CORS_ORIGINS=["https://cardapio.seudominio.com.br"]

# Uploads e backup (caminhos relativos ao diretório backend/)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
BACKUP_DIR=./backups
BACKUP_HOUR=3

# Debug — NUNCA true em produção
DEBUG=false
